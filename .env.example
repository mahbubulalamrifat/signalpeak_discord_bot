# Discord Developer Portal -> your application
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot -> Token. Required for the gateway connection that reads and forwards messages.
DISCORD_BOT_TOKEN=

# Optional. When set, management API calls must send header X-API-Key.
ADMIN_API_KEY=

# Optional fallback role assigned by approve_member when the request has no role_id.
APPROVAL_ROLE_ID=

# Write a database row when a source-server message has no matching channel. Default off so busy servers do not flood the log.
LOG_UNMATCHED_MESSAGES=false

LOG_LEVEL=INFO

# When set, routes and replace rules are loaded from this API and cached.
# Example: https://api.signalpeak.io/api
SIGNALPEAK_API_URL=
SIGNALPEAK_API_TOKEN=
